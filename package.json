{
  "name": "react-smart-pdf-viewer",
  "version": "1.5.2",
  "type": "module",
  "keywords": [
    "pdf",
    "react-pdf",
    "pdf-viewer",
    "pdfjs",
    "doc-to-pdf",
    "xls-to-pdf"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./plugins": "./dist/plugins.js",
    "./helpers": "./dist/helpers.js"
  },
  "typesVersions": {
    "*": {
      "plugins": [
        "dist/plugins.d.ts"
      ],
      "helpers": [
        "dist/helpers.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yathink3/react-smart-pdf-viewer.git"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "init": "npm i --legacy-peer-deps",
    "dev": "vite",
    "build": "vite build && cp src/*.d.ts dist/",
    "prepublish": "rm -rf ./dist && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bundled-es-modules/pdfjs-dist": "^3.6.172-alpha.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "oxfmt": "^0.49.0"
  }
}
